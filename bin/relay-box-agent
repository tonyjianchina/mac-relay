#!/usr/bin/env python3
"""Consumes finished results from EVERY relay channel and wakes the sender bot once (done/failed).

Channels: RELAY_URL (primary) and RELAY_FALLBACK_URL (comma-separated backups). One long-poll
thread per channel, all the time, so a result returned over any channel is picked up and a
channel recovering needs no switch-back. Results are deduplicated by task id: a per-task lock
plus the .wake marker (at-most-once) mean the same task delivered over two channels wakes the
sender once; the second copy is only acked.

Files are downloaded to <results>/<id>/<relative path> through .partial files with Range
resume, and checked against the size and sha256 the server reports (files_meta). result.json is
written only after every file is complete, then one wake. A failed download is not acked, so
the result is offered again and resumes. status=started is never sent to the sender webhook;
a stale started event is acked and .wake-started is written as skipped/no-webhook.
Env: RELAY_URL, RELAY_SECRET_FILE, RELAY_RESULTS_DIR (/workspace/relay-results),
RELAY_WAKE_DIR (/workspace/relay/wake), RELAY_FALLBACK_URL, RELAY_AGENT_PARALLEL (4).
Run under nohup/supervisor; not a cron job."""
import json, os, sys, threading, time, urllib.parse, urllib.request
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from relay.client import endpoints_from_env, secret
from relay.net import download_file, qseg, safe_rel

RES = os.environ.get("RELAY_RESULTS_DIR", "/workspace/relay-results")
WAKE = os.environ.get("RELAY_WAKE_DIR", "/workspace/relay/wake")
PARALLEL = threading.Semaphore(int(os.environ.get("RELAY_AGENT_PARALLEL", "4")))

def log(*a):
    print(time.strftime("%H:%M:%S"), *a, file=sys.stderr, flush=True)

EPS = endpoints_from_env(log)
_locks, _guard, ACTIVE = {}, threading.Lock(), set()

def tid_lock(tid):
    with _guard:
        return _locks.setdefault(tid, threading.Lock())

def wake(t, rdir):
    url_f, key_f = os.path.join(WAKE, t["sender"] + ".url"), os.path.join(WAKE, t["sender"] + ".key")
    try:
        url = open(url_f).read().strip(); key = open(key_f).read().strip()
    except OSError:
        log("ERROR no wake url/key for sender", t["sender"], "- task", t["id"], "not announced"); return "missing"
    body = json.dumps({"task_id": t["id"], "status": t["status"], "summary": t["summary"],
                       "sender": t["sender"], "result_path": rdir}).encode()
    req = urllib.request.Request(url, data=body, method="POST",
                                 headers={"Content-Type": "application/json", "Authorization": "Bearer " + key})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return f"http {r.status}"
    except Exception as e:
        log("ERROR wake failed for", t["id"], type(e).__name__); return "error"

def ack(ep, sec, tid, body=b"{}"):
    ep.call("POST", f"/results/{qseg(tid)}/ack", body, "application/json", deadline=30)

def handle(sec, t, ep=None):
    ep = ep or EPS[0]
    tid = t["id"]
    with tid_lock(tid):
        rdir = os.path.join(RES, tid); os.makedirs(rdir, exist_ok=True)
        if t.get("status") == "started":
            # Acceptance is returned by relay-send. Never POST the sender webhook for started.
            marker = os.path.join(rdir, ".wake-started")
            if not os.path.exists(marker):
                open(marker, "w").write("skipped/no-webhook\n")
                log("started", tid, "skipped/no-webhook")
            ack(ep, sec, tid, b'{"event":"started"}')
            return
        marker = os.path.join(rdir, ".wake")
        if os.path.exists(marker):
            log("duplicate", tid, "via", ep.name, "- already delivered, ack only")
        else:
            meta = {m.get("name"): m for m in t.get("files_meta") or [] if isinstance(m, dict)}
            paths, t0, total = [], time.time(), 0
            for n in t["files"]:
                rel = safe_rel(n)
                if not rel:
                    log("ERROR unsafe file name from relay", tid, repr(n)); continue
                p = os.path.join(rdir, *rel.split("/"))
                m = meta.get(n, {})
                total += download_file(ep, tid, "out", n, p, m.get("size"), m.get("sha256"))
                paths.append(p)
            res = {"task_id": tid, "sender": t["sender"], "tool": t["tool"], "status": t["status"],
                   "summary": t["summary"], "files": paths}
            tmp = os.path.join(rdir, "result.json.tmp")
            json.dump(res, open(tmp, "w"), indent=1); os.replace(tmp, os.path.join(rdir, "result.json"))
            open(marker, "w").write("attempting\n")  # at-most-once: written BEFORE the POST
            r = wake(t, rdir)
            open(marker, "w").write(r + "\n")
            log("delivered", tid, t["status"], "via", ep.name, f"{len(paths)} files {total} bytes",
                f"{time.time() - t0:.1f}s", "verified" if meta else "size-checked", "wake:", r)
        ack(ep, sec, tid)

def _work(sec, t, ep):
    try:
        handle(sec, t, ep)
    except Exception as e:
        log("handle pending", t["id"], "via", ep.name, type(e).__name__, str(e)[:160])
    finally:
        with _guard:
            ACTIVE.discard((ep.name, t["id"]))
        PARALLEL.release()

def consume(sec, ep):
    back = 1
    while True:
        try:
            with _guard:
                busy = sorted(tid for (n, tid) in ACTIVE if n == ep.name)
            ex = ("&exclude=" + ",".join(qseg(x) for x in busy[:64])) if busy else ""
            st, j = ep.json("GET", "/results/next?wait=50" + ex, deadline=95)
            back = 1
            if st != 200:
                continue
            t = j["task"]
            with _guard:
                dup = (ep.name, t["id"]) in ACTIVE
                if not dup:
                    ACTIVE.add((ep.name, t["id"]))
            if dup:  # old server ignores exclude: it offers what we are still downloading
                time.sleep(2); continue
            PARALLEL.acquire()
            threading.Thread(target=_work, args=(sec, t, ep), daemon=True).start()
        except Exception as e:
            if back == 1 or back >= 60:
                log("relay unreachable:", ep.name, type(e).__name__, str(e)[:120], "retry in", back)
            time.sleep(back); back = min(back * 2, 60)

def main():
    sec = secret()
    log("box-agent channels:", ", ".join(f"{e.name}={e.url}" for e in EPS))
    for ep in EPS[1:]:
        threading.Thread(target=consume, args=(sec, ep), daemon=True, name="consume-" + ep.name).start()
    consume(sec, EPS[0])

if __name__ == "__main__":
    main()
