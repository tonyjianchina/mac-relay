{
  "endpoints": [
    {
      "name": "box",
      "url": "http://100.a.b.c:18790"
    },
    {
      "name": "vps-ts",
      "url": "http://100.x.y.z:18791"
    },
    {
      "name": "vps",
      "url": "https://relay.example.com/relay"
    }
  ],
  "secret_file": "~/.config/mac-relay/secret",
  "state_dir": "~/Library/Application Support/mac-relay",
  "worker_name": "mac",
  "max_soft_file": 16777216,
  "max_backoff_s": 60,
  "tools": {
    "hermes": [
      "/path/to/hermes",
      "run",
      "--prompt-file",
      "{prompt_file}",
      "--out",
      "{outbox}"
    ],
    "deepseek": [
      "/path/to/deepseek-harness",
      "--prompt-file",
      "{prompt_file}",
      "--inbox",
      "{inbox}"
    ],
    "codex": [
      "codex",
      "exec",
      "-m",
      "gpt-6.1-sol",
      "{prompt}"
    ],
    "schwab": [
      "/path/to/schwab-relay-run",
      "{prompt_file}"
    ]
  },
  "mirror_after_s": 60,
  "closeout_after_s": 600,
  "stdin_prompt_over": {
    "codex": 100000
  }
}
