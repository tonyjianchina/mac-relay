RELAY_URL=https://relay.example.com/relay
RELAY_SECRET_FILE=/path/to/relay/secret
RELAY_RESULTS_DIR=/workspace/relay-results
RELAY_WAKE_DIR=/workspace/relay/wake
# Optional backup address (e.g. the relay host's Tailscale IP). Used after RELAY_FAIL_THRESHOLD
# consecutive primary failures (conn error / HTTP 5xx); probes the primary every RELAY_COOLDOWN_S.
RELAY_FALLBACK_URL=http://100.x.y.z:18791
RELAY_FAIL_THRESHOLD=3
RELAY_COOLDOWN_S=300
