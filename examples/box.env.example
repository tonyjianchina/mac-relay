# VPS + Caddy: `handle_path /relay/*` strips the prefix, so this base URL ends in /relay.
# With no reverse proxy, use the server root and do not append /relay
# (http://127.0.0.1:18790 or http://100.x.y.z:18790). See docs/no-vps.md
# and docs/no-vps.zh-CN.md.
# Task attachments (--file) are multipart. The server caps that at
# RELAY_MAX_SOFT_BODY (default 16MiB). relay-send does not stream large inputs.
# Worker outputs use PUT and are not sent from this client.
RELAY_URL=https://relay.example.com/relay
RELAY_SECRET_FILE=/path/to/relay/secret
RELAY_RESULTS_DIR=/workspace/relay-results
RELAY_WAKE_DIR=/workspace/relay/wake
# Optional second base URL. Leave unset when there is only one.
# Used after RELAY_FAIL_THRESHOLD consecutive primary failures (conn error / HTTP 5xx);
# probes the primary every RELAY_COOLDOWN_S. The value below is the VPS checklist's
# Tailscale Caddy listener, not a second port inside server.py.
RELAY_FALLBACK_URL=http://100.x.y.z:18791
RELAY_FAIL_THRESHOLD=3
RELAY_COOLDOWN_S=300
